{
  "name": "redhat-catalog",
  "repository": "https://github.com/axel7083/pd-redhat-catalog-ext",
  "displayName": "Red Hat Catalog",
  "description": "Browse, inspect and pull container images from the Red Hat Ecosystem Catalog.",
  "version": "0.1.0",
  "icon": "icon.png",
  "publisher": "redhat",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "podman-desktop": ">=1.30.0"
  },
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vite build",
    "watch": "vite --mode development build -w",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "pyxis:schema": "node scripts/download-pyxis-schema.mjs",
    "pyxis:codegen": "graphql-codegen --config codegen.ts",
    "measure": "vitest run --config vitest.measure.config.ts"
  },
  "contributes": {},
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@podman-desktop/api": "^1.30.5",
    "@podman-desktop/extension-redhat-catalog-core-api": "workspace:^",
    "@types/node": "^24",
    "graphql": "^17.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "inversify": "^8.3.0",
    "zod": "^4.6.7"
  }
}
