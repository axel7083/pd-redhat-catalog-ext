{
  "name": "frontend",
  "private": true,
  "displayName": "frontend UI",
  "description": "Frontend UI for the Red Hat Catalog extension",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite --mode development build -w",
    "test": "vitest --config ./vitest.config.ts --run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@podman-desktop/extension-redhat-catalog-core-api": "workspace:^",
    "@podman-desktop/ui-svelte": "^1.30.5",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "dompurify": "^3.4.17",
    "filesize": "^11.0.29",
    "jsdom": "^30.1.3",
    "marked": "^18.2.0",
    "monaco-editor": "^0.57.0",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-fa": "^4.0.4",
    "svelte-select": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
