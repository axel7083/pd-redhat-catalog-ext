{
  "name": "redhat-catalog-monorepo",
  "repository": "https://github.com/axel7083/pd-redhat-catalog-ext",
  "displayName": "Red Hat Catalog",
  "description": "Browse, inspect and pull container images from the Red Hat Ecosystem Catalog.",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:backend": "pnpm --dir packages/backend build",
    "build:frontend": "pnpm --dir packages/frontend build",
    "build:shared": "pnpm --dir packages/shared build",
    "build": "pnpm build:shared && concurrently \"pnpm build:frontend\" \"pnpm build:backend\"",
    "watch": "concurrently \"pnpm --dir packages/shared watch\" \"pnpm --dir packages/frontend watch\" \"pnpm --dir packages/backend watch\"",
    "format:check": "prettier --check \"packages/**/*.{ts,js,json,svelte}\"",
    "format:fix": "prettier --write \"packages/**/*.{ts,js,json,svelte}\"",
    "lint:check": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --fix",
    "pyxis:schema": "pnpm --dir packages/backend pyxis:schema",
    "pyxis:codegen": "pnpm --dir packages/backend pyxis:codegen",
    "test:backend": "vitest run --project redhat-catalog",
    "test:frontend": "pnpm --dir packages/frontend test",
    "test:shared": "vitest run --project @podman-desktop/extension-redhat-catalog-core-api",
    "test:contract": "pnpm --dir packages/backend test:contract",
    "test": "pnpm test:shared && pnpm test:backend && pnpm test:frontend",
    "typecheck:shared": "tsc --noEmit --project packages/shared",
    "typecheck:frontend": "pnpm --dir packages/frontend check",
    "typecheck:backend": "tsc --noEmit --project packages/backend",
    "typecheck": "pnpm typecheck:shared && pnpm typecheck:frontend && pnpm typecheck:backend"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@podman-desktop/api": "^1.30.5",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "semver": "^7.7.3",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4"
}
